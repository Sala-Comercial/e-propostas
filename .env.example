# Copie este arquivo para ".env" e preencha. O .env NUNCA vai para o git
# nem para o chat: só fica neste computador.

# Banco Postgres. Trocar de lugar = trocar esta linha e rodar "npm run migrar".
#   Postgres.app (este Mac):  postgres://SEU_USUARIO_DO_MAC@127.0.0.1:5432/criador
#   Supabase local:           postgresql://postgres:postgres@127.0.0.1:54322/postgres
#   Supabase na nuvem:        a "Session pooler" do painel (Connect), com a senha do banco
DATABASE_URL=
# só para o Supabase na nuvem: o certificado baixado do painel (confere quem é o servidor)
DATABASE_CA_FILE=
# "nao" = não aplica migrações ao ligar (quando outra pessoa cuida delas)
MIGRAR_AO_INICIAR=sim

# Porta e endereço. 127.0.0.1 = só este computador acessa; 0.0.0.0 = abre para a rede local.
PORTA=8790
HOST=127.0.0.1

# GPT (OpenAI) — https://platform.openai.com/api-keys
OPENAI_API_KEY=
# modelo do chat; recomendado: gpt-6.1-sol (bom e barato). Outros: gpt-6-astra, gpt-6-luna
OPENAI_MODELO=gpt-6.1-sol

# HubSpot — token de "app privado" com os escopos
#   crm.objects.deals.read, crm.objects.deals.write, crm.objects.owners.read
HUBSPOT_TOKEN=
# opcionais: funil e etapa onde nasce o negócio criado pelo chat
HUBSPOT_PIPELINE=
HUBSPOT_ETAPA=
